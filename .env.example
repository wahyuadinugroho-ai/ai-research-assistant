# API Key
# Gemini API Key (required) — get free at https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here
# Exa API Key (optional, for web search tool) — get at https://exa.ai/
EXA_API_KEY=your_exa_api_key

# Model configuration (optional — sensible defaults are shown)
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
TEMPERATURE=0.2

# RAG chunking settings (optional)
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
TOP_K=5
